  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd // empty'); model=$(echo \"$input\" | jq -r '.model.display_name // empty'); used_pct=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); vim_mode=$(echo \"$input\" | jq -r '.vim.mode // empty'); session_name=$(echo \"$input\" | jq -r '.session_name // empty'); short_cwd=\"${cwd/#$HOME/~}\"; git_branch=$(git -C \"${cwd:-.}\" symbolic-ref --short HEAD 2>/dev/null || git -C \"${cwd:-.}\" rev-parse --short HEAD 2>/dev/null); used_int=${used_pct%.*}; used_int=${used_int:-0}; filled=$(( used_int / 10 )); empty_bars=$(( 10 - filled )); bar=$(printf '█%.0s' $(seq 1 $filled 2>/dev/null))$(printf '░%.0s' $(seq 1 $empty_bars 2>/dev/null)); parts=\"\"; sep=$(printf '\\033[2m|\\033[0m'); [ -n \"$short_cwd\" ] && parts=\"$(printf '\\033[34m%s\\033[0m' \"$short_cwd\")\"; [ -n \"$git_branch\" ] && parts=\"$parts $sep $(printf '\\033[32m%s\\033[0m' \"$git_branch\")\"; [ -n \"$model\" ] && parts=\"$parts $sep $(printf '\\033[2m%s\\033[0m' \"$model\")\"; if [ -n \"$used_pct\" ]; then if [ \"$used_int\" -ge 90 ]; then ctx_color=31; elif [ \"$used_int\" -ge 70 ]; then ctx_color=33; else ctx_color=2; fi; parts=\"$parts $sep $(printf \"\\033[${ctx_color}mctx:${bar} ${used_int}%\\033[0m\")\"; fi; [ -n \"$vim_mode\" ] && { [ \"$vim_mode\" = INSERT ] && vc=32 || vc=33; parts=\"$parts $sep $(printf \"\\033[${vc}m[${vim_mode}]\\033[0m\")\"; }; [ -n \"$session_name\" ] && parts=\"$parts $sep $(printf '\\033[2m\\\"%s\\\"\\033[0m' \"$session_name\")\"; printf '%s' \"$parts\""
  },
